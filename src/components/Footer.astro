---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12">
      <!-- Brand Info -->
      <div class="space-y-4 md:col-span-2">
        <a href="/" class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-tech-indigo flex items-center justify-center text-white font-display font-extrabold text-lg">
            S
          </span>
          <span class="font-display font-bold text-white text-lg tracking-tight">
            siza<span class="text-tech-accent">.dev</span>
          </span>
        </a>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed">
          Expert coding tutorials, Git branching strategies, API testing guides, and career roadmaps for software engineers and modern developers.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-display font-bold text-white text-sm uppercase tracking-wider mb-4">
          Platform
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-white transition">Home</a>
          </li>
          <li>
            <a href="/blog" class="hover:text-white transition">Dev Blog</a>
          </li>
          <li>
            <a href="/about" class="hover:text-white transition">About Us</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition">Contact</a>
          </li>
        </ul>
      </div>

      <!-- Legal / AdSense Compliance -->
      <div>
        <h3 class="font-display font-bold text-white text-sm uppercase tracking-wider mb-4">
          Compliance
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="hover:text-white transition">Terms of Service</a>
          </li>
          <li class="text-xs text-slate-500 pt-2 leading-relaxed">
            siza.dev is an independent developer resource. All tutorials, code snippets, and setup guides are for educational purposes.
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider & Bottom Area -->
    <div class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
      <p>&copy; {currentYear} siza.dev. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>Guides for Modern Developers</span>
      </div>
    </div>
  </div>
</footer>
