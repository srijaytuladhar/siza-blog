---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  type="article"
  publishedTime={entry.data.pubDate.toISOString()}
  authorName={entry.data.author}
>
  <article class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex text-xs md:text-sm text-slate-500 mb-6 font-medium gap-2 items-center">
      <a href="/" class="hover:text-slate-900 transition">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-slate-900 transition">Blog</a>
      <span>/</span>
      <span class="text-slate-900 truncate max-w-[200px] md:max-w-none">{entry.data.title}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8 md:mb-12">
      {entry.data.category && (
        <span class="inline-block bg-brand-50 text-tech-indigo text-xs font-bold font-display px-3 py-1 rounded-lg uppercase tracking-wider mb-4 border border-brand-200">
          {entry.data.category}
        </span>
      )}
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-slate-900 leading-tight mb-6">
        {entry.data.title}
      </h1>

      <!-- Author and Meta -->
      <div class="flex items-center gap-4 border-y border-slate-100 py-4">
        <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center font-display font-bold text-sm">
          {entry.data.author.charAt(0)}
        </div>
        <div>
          <span class="block text-slate-900 font-semibold text-sm">{entry.data.author}</span>
          <span class="block text-slate-500 text-xs mt-0.5">{formattedDate} &bull; 5 min read</span>
        </div>
      </div>
    </header>

    <!-- Post Featured Image -->
    {entry.data.image && (
      <div class="aspect-[16/9] rounded-2xl md:rounded-3xl overflow-hidden bg-slate-100 mb-10 shadow-sm">
        <img
          src={entry.data.image}
          alt={entry.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Main Content rendered inside custom prose block -->
    <div class="prose max-w-none">
      <Content />
    </div>

    <!-- AdSense Slot within Article -->
    <AdSense slot="article-mid-page" />

    <!-- Related Tags -->
    <div class="border-t border-slate-100 mt-10 pt-6 flex flex-wrap gap-2">
      {entry.data.tags.map((tag: string) => (
        <span class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1 rounded-lg">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Author Bio Box -->
    <div class="bg-slate-50 rounded-2xl p-6 md:p-8 border border-slate-100 my-12 flex flex-col sm:flex-row gap-5 items-start">
      <div class="w-14 h-14 rounded-full bg-tech-indigo text-white flex items-center justify-center font-display font-bold text-lg flex-shrink-0">
        {entry.data.author.charAt(0)}
      </div>
      <div>
        <h4 class="font-display font-bold text-slate-900 mb-1">About {entry.data.author}</h4>
        <p class="text-slate-600 text-sm leading-relaxed mb-3">
          Srijay is a Full Stack Developer at Fonepay Payment Service Ltd., focused on making complex coding concepts and modern tools intuitive for developers.
        </p>
      </div>
    </div>

    <!-- Bottom Newsletter Signup Capture -->
    <NewsletterForm
      title="Never Miss a Dev Update"
      description="Get our next deep-dive developer tutorial, AI automation guide, or career roadmap delivered directly to you."
    />
  </article>
</BaseLayout>

<script>
  // @ts-ignore
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';

  const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');

  if (mermaidBlocks.length > 0) {
    mermaidBlocks.forEach((pre) => {
      const code = pre.querySelector('code');
      if (code) {
        const rawCode = code.textContent;
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = rawCode;
        pre.replaceWith(div);
      }
    });

    mermaid.initialize({
      startOnLoad: true,
      theme: 'neutral',
      securityLevel: 'loose',
    });
  }
</script>

