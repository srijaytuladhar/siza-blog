---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find(post => post.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter(post => post.slug !== featuredPost.slug).slice(0, 3);
---

<BaseLayout
  title="Developer Guides, AI Tools &amp; Workflows"
  description="Practical, step-by-step guides on AI programming, Git branching, GitLab migration, VS Code extensions, API testing, and remote developer career moves."
>
  <!-- Hero Section with Immediate Newsletter Capture -->
  <section class="py-12 md:py-20 border-b border-slate-100">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-50 text-tech-indigo border border-brand-200 uppercase tracking-wider font-display">
          🚀 High-Impact Developer Resources
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-slate-900 leading-tight tracking-tight">
          Demystifying <span class="text-tech-indigo">Coding</span> &amp; Modern Workflows
        </h1>
        <p class="text-slate-600 text-lg md:text-xl leading-relaxed max-w-2xl">
          Step-by-step guides for solo developer Git structures, GitLab migrations, Postman API testing, and using Claude/ChatGPT to automate workflows and write clean code.
        </p>
        
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/blog"
            class="px-6 py-3.5 bg-tech-indigo hover:bg-indigo-700 text-white font-display font-bold rounded-xl transition shadow-lg shadow-indigo-950/10 active:scale-[0.98] text-sm"
          >
            Start Reading
          </a>
          <a
            href="/about"
            class="px-6 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-display font-semibold rounded-xl transition active:scale-[0.98] text-sm"
          >
            About Us
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <NewsletterForm />
      </div>
    </div>
  </section>

  <!-- Featured Post Section -->
  {featuredPost && (
    <section class="py-12 md:py-16 border-b border-slate-100">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-display font-extrabold text-slate-900">
          Featured Article
        </h2>
        <span class="w-16 h-1 bg-tech-accent rounded"></span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white border border-slate-100 rounded-3xl p-6 md:p-10 shadow-sm hover:shadow-md transition-all duration-300 relative overflow-hidden group">
        {featuredPost.data.image && (
          <div class="lg:col-span-7 aspect-[16/10] rounded-2xl overflow-hidden bg-slate-100 relative">
            <img
              src={featuredPost.data.image}
              alt={featuredPost.data.title}
              class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500"
            />
            {featuredPost.data.category && (
              <span class="absolute top-4 left-4 bg-slate-900/90 backdrop-blur-sm text-white text-xs font-bold font-display px-3 py-1 rounded-lg uppercase tracking-wider">
                {featuredPost.data.category}
              </span>
            )}
          </div>
        )}

        <div class="lg:col-span-5 space-y-4">
          <div class="flex items-center gap-3 text-xs text-slate-500 font-semibold">
            <time datetime={featuredPost.data.pubDate.toISOString()}>
              {featuredPost.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <span>&bull;</span>
            <span>5 min read</span>
          </div>

          <h3 class="text-2xl md:text-3xl font-display font-extrabold text-slate-900 group-hover:text-tech-indigo transition-colors leading-tight">
            <a href={`/blog/${featuredPost.slug}`}>
              {featuredPost.data.title}
            </a>
          </h3>

          <p class="text-slate-600 leading-relaxed text-sm md:text-base">
            {featuredPost.data.description}
          </p>

          <div class="pt-4 flex items-center justify-between">
            <a
              href={`/blog/${featuredPost.slug}`}
              class="inline-flex items-center gap-1.5 text-sm font-bold font-display text-tech-indigo hover:text-indigo-700 transition"
            >
              Read Full Article
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Central Ad Placement -->
  <AdSense slot="home-central-banner" />

  <!-- Recent Posts Grid -->
  <section class="py-12 md:py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl md:text-3xl font-display font-extrabold text-slate-900">
          Latest Articles
        </h2>
        <p class="text-slate-500 text-sm mt-1">Stay ahead with modern dev practices and tools.</p>
      </div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1 text-sm font-bold font-display text-tech-indigo hover:text-indigo-700 transition"
      >
        View All Articles
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {recentPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
